{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bible - Kairos Collection",
  "version": "0.1.0",
  "identifier": "com.kaslorin.kairos",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bible: Kairos Collection",
        "width": 1340,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bible_vault.db.gz",
      "resources/study_vault.db.gz"
    ]
  }
}
